meta {
  name: Dev Login Free
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/dev-login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role": "free"
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.data?.token) {
    bru.setEnvVar("freeToken", body.data.token);
  }
}

assert {
  res.status: eq 200
  res.body.ok: eq true
}
